# Copy to .env.local for npm run dev (Vite proxies /api and /stream).
# Set the same variable in Vercel project settings for production middleware.js.
TARS_UPSTREAM=https://your-upstream.example

# Shared key the origin's Caddy requires on /api/* (origin lockdown). Production
# only — set in Vercel project settings, never commit the live value. Dev proxy
# does not need it (it talks to whatever TARS_UPSTREAM you point at).
TARS_ORIGIN_KEY=replace-with-origin-key